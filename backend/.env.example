# vLLM connection (OpenAI-compatible endpoint)
VLLM_BASE_URL=http://vllm:8000/v1
# 相容 OpenAI Client；多數自建 vLLM 可保留 EMPTY 或省略
VLLM_API_KEY=EMPTY
#VLLM_MODEL="Xingyu-Zheng/gemma-4-E2B-it-int4-foem"
VLLM_MODEL="Qwen/Qwen2.5-7B-Instruct-AWQ"
# 知識庫摘要用（可留空，程式會退回 VLLM_MODEL 或內建預設）
# VLLM_SUMMARY_MODEL=

# TTS：edge（預設）或 kokoro。前端只打 POST /api/tts，由此變數決定引擎。
# edge：走微軟 Edge TTS；失敗則改 Kokoro。kokoro：直接走本機 Kokoro，不打 Edge。
TTS_PROVIDER=edge

# Edge TTS
EDGE_DEFAULT_VOICE=zh-TW-HsiaoChenNeural
EDGE_RATE=-3%

# Kokoro TTS（TTS_PROVIDER=kokoro，或 Edge 失敗時的備援）
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_DEFAULT_VOICE=zf_xiaoxiao
KOKORO_SPEED=0.85

# STT queue
STT_GPU_CONCURRENCY=15
STT_QUEUE_MAX_SIZE=30
STT_QUEUE_TIMEOUT=120

# 外部系統整合 API Key（X-API-Key header；用於 /integration/* 與受保護的對話查詢）
# 亦作為呼叫 JarvisPlatform Integration API 的金鑰（與 Jarvis 端同值）
# INTEGRATION_API_KEY=your-secret-key-here

# JarvisPlatform（Notebook 清單 / Knowledge Search）
# NOTEBOOK_KNOWLEDGE_MODE=mock  # mock | http（預設 mock）
# JARVIS_BASE_URL=https://192.168.1.206:8443
# JARVIS_HTTP_TIMEOUT=30

# Database connection pool
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60
