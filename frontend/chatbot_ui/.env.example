# Vite：僅 VITE_ 前綴會注入前端；變更後請重新 npm run dev / build
# 開發環境 API/WS 由 vite.config.js proxy 轉發，無需設定 VITE_API_BASE_URL

# dev proxy 目標（僅 vite.config.js 使用，非 VITE_ 前綴）
PROXY_TARGET=https://portal2.musesai.com:8443

# TTS 聲線／語速（引擎由後端 TTS_PROVIDER 決定，前端只打 /api/tts）
VITE_EDGE_VOICE=zh-TW-HsiaoChenNeural
VITE_EDGE_RATE=-3%
